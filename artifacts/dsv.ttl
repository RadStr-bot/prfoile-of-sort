<https://example.com/profile/vocabulary#> a prof:Profile, dsv:ApplicationProfile.
:A dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    dsv:reusesPropertyValue [
  a dsv:PropertyValueReuse;
  dsv:reusedProperty skos:prefLabel;
  dsv:reusedFromResource <https://example.com/vocabulary#A>
], [
  a dsv:PropertyValueReuse;
  dsv:reusedProperty skos:definition;
  dsv:reusedFromResource <https://example.com/vocabulary#A>
];
    a dsv:ClassProfile;
    dsv:class <https://example.com/vocabulary#A>.
:C dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    dsv:reusesPropertyValue [
  a dsv:PropertyValueReuse;
  dsv:reusedProperty skos:prefLabel;
  dsv:reusedFromResource <https://example.com/vocabulary#C>
], [
  a dsv:PropertyValueReuse;
  dsv:reusedProperty skos:definition;
  dsv:reusedFromResource <https://example.com/vocabulary#C>
];
    a dsv:ClassProfile;
    dsv:class <https://example.com/vocabulary#C>.
:B dct:isPartOf <https://example.com/profile/vocabulary#>;
    a dsv:TermProfile;
    dsv:reusesPropertyValue [
  a dsv:PropertyValueReuse;
  dsv:reusedProperty skos:prefLabel;
