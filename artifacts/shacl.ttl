@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.com/profile/vocabulary#> rdfs:member <https://example.com/profile/vocabulary#vocabulary:AShape>, <https://example.com/profile/vocabulary#vocabulary:CShape>, <https://example.com/profile/vocabulary#vocabulary:BShape>.

<https://example.com/profile/vocabulary#vocabulary:AShape> a sh:NodeShape;
    rdfs:seeAlso <https://example.com/profile/vocabulary#A>;
    sh:closed false;
    sh:targetClass <https://example.com/vocabulary#A>.

<https://example.com/profile/vocabulary#vocabulary:CShape> a sh:NodeShape;
    rdfs:seeAlso <https://example.com/profile/vocabulary#C>;
    sh:closed false;
    sh:targetClass <https://example.com/vocabulary#C>.

<https://example.com/profile/vocabulary#vocabulary:BShape> a sh:NodeShape;
    rdfs:seeAlso <https://example.com/profile/vocabulary#B>;
    sh:closed false;
    sh:targetClass <https://example.com/vocabulary#B>.

